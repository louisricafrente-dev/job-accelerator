{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src,scripts,data}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 */6 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
