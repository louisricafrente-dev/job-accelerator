{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src,scripts,data}/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/actions-migration": false
    }
  }
}
